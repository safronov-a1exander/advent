# День 6 — первый агент.
#
# Прогон:
#   .\scripts\demo.ps1 -Name day06 -MaxSeconds 900 -AppArgsList @(
#     @('demo','-script','scripts/day06.demo','-title','advent · день 6 — агент как отдельная сущность'),
#     @('swarm','-fleet','agents/fleet.yaml','-hold','20s'))
#
# Что показываем: снаружи экран не изменился, но разговаривает теперь агент.
# У агента свой конфиг и своя история; агентов в одном процессе может быть
# несколько — это разговоры, между которыми переключаешься, как между вкладками.

speed 18ms
sleep 1500ms

note Снаружи тот же чат. Внутри экран больше не ходит в API: разговаривает агент.
sleep 6s

note Агент — отдельный объект: свой конфиг, свой стек сообщений, свой расход.
sleep 5s

type Привет! Меня зовут Саша, веду бюджет на сентябрь — 60000 рублей.
sleep 700ms
key enter
wait 180s
sleep 3s

type Как меня зовут и какой у меня бюджет?
sleep 700ms
key enter
wait 180s
sleep 4s

note Помнит — потому что агент сам сложил историю и отправил её целиком. Модель ничего не хранит.
sleep 6s

note Ctrl+D — что внутри агента и какой стек уйдёт в API следующим запросом.
sleep 3s
key ctrl+d
sleep 9s

note Ctrl+N — новый разговор. Настройки скопированы, история и лента пустые.
sleep 3s
key ctrl+n
sleep 4s

type Как меня зовут?
sleep 700ms
key enter
wait 180s
sleep 5s

note Не знает: у второго агента своя история, первого разговора в ней нет.
sleep 6s

note Ctrl+O — список агентов. У каждого видно, о чём разговор и сколько в нём сообщений.
sleep 3s
key ctrl+o
sleep 6s
key up
sleep 2s

note Enter — возвращаемся к первому разговору ровно в том виде, в каком оставили.
sleep 3s
key enter
sleep 4s

type Напомни, как меня зовут?
sleep 700ms
key enter
wait 180s
sleep 5s

note Ctrl+D ещё раз: в пуле два агента, у каждого свой стек.
sleep 3s
key ctrl+d
sleep 9s

note Ctrl+E — сравнение моделей теперь тоже агенты: по одному на модель, отвечают параллельно.
sleep 4s
type Бюджет 60000, потрачено 38865. Сколько осталось? Ответь одним числом.
sleep 700ms
key enter
wait 180s
sleep 3s
key ctrl+e
wait 300s
sleep 9s

note Дальше — флот: десять агентов с разными конфигами из YAML в одном процессе.
sleep 5s
quit
