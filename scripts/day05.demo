# День 5 — версии моделей.
# Прогон: .\scripts\demo.ps1 -Name day05 -AppArgs @('lab','-scenario','scenarios/day05-models.yaml','-script','scripts/day05.demo') -MaxSeconds 1200

sleep 1500ms
note Рабочий запрос ассистента — расчёт бюджета по выписке — на трёх конфигурациях моделей.
sleep 8s

note У задачи один верный ответ — 38865. Значит «качество» здесь измеримо, а не на глаз.
sleep 7s

key r
wait 900s
sleep 2s

note Сводка. Колонки: средняя задержка, скорость генерации в токенах в секунду, in/out/reasoning токены, стоимость.
sleep 12s

key t
sleep 1s
note Слабая конфигурация: рассуждения выключены, ответ приходит сразу.
sleep 8s

key down
sleep 1s
note Та же модель с рассуждениями. Разница не в размере модели, а в режиме инференса — reasoning-токены видны отдельно и оплачиваются как output.
sleep 12s

key down
sleep 1s
note Старшая модель: окупается ли разница в цене за output на этой задаче.
sleep 10s

key t
sleep 1s
note Класс модели — не одно число: параметры, квантизация, контекст, режим рассуждений и цена за output.
sleep 12s

note Отчёт в reports/ содержит таблицу моделей со ссылками и характеристиками.
sleep 8s
quit
