# День 1 — первый запрос к LLM через API.
# Сквозной проект: «Бюджет» — ассистент по личным тратам.
#
# Прогон: .\scripts\demo.ps1 -Name day01 -AppArgs @('demo','-script','scripts/day01.demo','-title','advent · день 1 — первый запрос к LLM через API')
#
# Сценарий повторяет обычную ручную работу: те же клавиши, что жмёт человек.
# Без флага -script приложение полностью интерактивно.

speed 20ms
sleep 1500ms

note Ассистент по личным тратам. Начинаем с простейшего: вопрос и ответ.
sleep 6s

note Клиент на Go: POST /chat/completions, ключ из переменной окружения.
sleep 5s

note Справа — параметры запроса. Они правятся прямо здесь, без перезапуска с флагами.
sleep 5s

note Запрос #1 — обычный вопрос про траты, ответ приходит потоком (SSE).
sleep 3s
type За выходные потратил: супермаркет 2340, кофейня 390, такси 620, маркетплейс 4150. Сколько всего и на что ушло больше всего?
sleep 800ms
key enter
wait 180s
sleep 4s

note Под ответом — finish_reason, задержка, токены и стоимость вызова.
sleep 5s

note Запрос #2 — уточняющий. Он работает только потому, что история уходит в запрос целиком.
sleep 3s
type А если убрать маркетплейс — сколько останется?
sleep 800ms
key enter
wait 180s
sleep 4s

note prompt-токенов стало больше: в запрос ушла вся история диалога.
sleep 6s

note Tab переводит фокус в панель параметров.
sleep 2s
key tab
sleep 2s

note Стрелкой вниз выбираем системный промпт, Enter — ввести значение.
sleep 3s
key down
sleep 1500ms
key enter
sleep 1500ms
type Ты строгий бухгалтер. Отвечай сухо, одной строкой, только цифрами и категорией.
sleep 1s
key enter
sleep 2s

note Системный промпт подставляется в каждый запрос заново, поэтому правка действует сразу.
sleep 5s

key esc
sleep 1s
type Повтори итог по тем же тратам.
sleep 800ms
key enter
wait 180s
sleep 4s

note Тон изменился — те же данные, другой system.
sleep 6s

note Ctrl+R сбрасывает контекст: следующий запрос уйдёт без истории.
sleep 3s
key ctrl+r
sleep 2s
type Сколько я потратил на такси?
sleep 800ms
key enter
wait 180s
sleep 5s

note Ассистент не помнит трат: памяти у API нет, её создаёт клиент, отправляя историю.
sleep 7s

note Дальше — структурированный разбор выписки, расчёт по нему и выбор модели.
sleep 7s

note Все вызовы записаны в runs/*.jsonl — запрос, параметры, usage, стоимость.
sleep 5s
quit
