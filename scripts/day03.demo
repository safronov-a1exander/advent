# День 3 — разные способы рассуждения.
# Прогон: .\scripts\demo.ps1 -Name day03 -AppArgs @('lab','-scenario','scenarios/day03-reasoning.yaml','-script','scripts/day03.demo') -MaxSeconds 1500

sleep 1500ms
note Расчёт остатка бюджета по той же выписке. Верный ответ один — 38865. Четыре способа, по два прогона.
sleep 7s

note В выписке четыре ловушки: операция не того месяца, перевод на копилку, снятие наличных и сумма в долларах.
sleep 6s

note Прогон: 16 вызовов, займёт пару минут.
sleep 2s
key r
wait 900s
sleep 2s

note Сводка. Колонка УСПЕХ — сколько прогонов из двух дали верный ответ.
sleep 10s

key t
sleep 1s
note Способ 1 — прямой ответ. Обычно здесь и теряется одно из двух правил.
sleep 8s

key down
sleep 1s
note Способ 2 — та же задача плюс «решай пошагово». Отличие только в одной фразе промпта.
sleep 10s

key down
sleep 1s
note Способ 3 — сначала модель пишет промпт для самой себя, потом решает по нему. Видны оба шага.
sleep 12s

key down
sleep 1s
note Способ 4 — аналитик, инженер, критик, синтез: четыре вызова, каждый видит результат предыдущего.
sleep 14s

key t
sleep 1s
note Смотрим на колонку УСПЕХ и на цену: длинная цепочка стоит в разы дороже, и это не гарантирует попадания.
sleep 12s
quit
